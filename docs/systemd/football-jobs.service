[Unit]
Description=Football Predictor server jobs (tomorrow + standings)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/football-predictor
EnvironmentFile=/opt/football-predictor/.env
ExecStart=/opt/football-predictor/.venv/bin/python -m jobs
Restart=on-failure
RestartSec=5
User=football
Group=football

[Install]
WantedBy=multi-user.target
