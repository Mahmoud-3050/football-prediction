BOT_TOKEN=
FOOTBALL_API_KEY=
# Optional. Saudi Pro League (SPL) season history via Live Football API (/league_fixtures).
LIVE_FOOTBALL_API_KEY=
# Optional. SPL live fixtures/standings via API Ninjas (fallback if Live Football unset).
NINJAS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
LOG_LEVEL=INFO
DATABASE_PATH=data/football.db
# Legacy in-bot pre-round (off by default). Prefer: python -m jobs
PRE_ROUND_ENABLED=0
PRE_ROUND_INTERVAL_SECONDS=3600
JOBS_INTERVAL_SECONDS=3600
# Dashboard (python -m laboratory serve). Required when binding outside 127.0.0.1.
# When set, the dashboard shows a Sign in page and issues a session cookie.
# Use a long random DASHBOARD_PASSWORD and DASHBOARD_SESSION_SECRET (never commit .env).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
# Set to 1 behind HTTPS reverse proxy.
DASHBOARD_COOKIE_SECURE=0
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
